URxvt.font:			xft:Dejavu Sans Mono:style=Regular:pixelsize=21
URxvt.boldFont:			xft:Dejavu Sans Mono:style=Bold:pixelsize=21
URxvt.letterSpace:		0
URxvt.internalBorder:		9
URxvt.scrollBar:		false
URxvt.mouseWheelScrollPage:	false

URxvt.iso14755: false
URxvt.iso14755_52: false

URxvt*inheritPixmap: true
URxvt*transparent: true
! URxvt*shading: 0 to 99 darkens, 101 to 200 lightens
URxvt*shading: 40

! special
*.foreground:   #c5c8c6
! *.foreground:   #f0f0f0
! *.background:   #1d1f21
*.background:   #000000
*.cursorColor:  #c5c8c6

! black
*.color0:       #282a2e
*.color8:       #373b41

! red
*.color1:       #a54242
*.color9:       #cc6666

! green
*.color2:       #b5bd68
*.color10:      #8c9440

! yellow
*.color3:       #de935f
*.color11:      #f0c674

! blue
*.color4:       #5f819d
*.color12:      #86abcb

! magenta
*.color5:       #85678f
*.color13:      #b294bb

! cyan
*.color6:       #5e8d87
*.color14:      #8abeb7

! white
*.color7:       #707880
*.color15:      #c5c8c6
